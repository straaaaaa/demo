            "value": ["A", "Left"],
            "type": "keybind"
        },
        "down": {
            "value": ["S", "Down"],
            "type": "keybind"
        },
        "up": {
            "value": ["W", "Up"],
            "type": "keybind"
        },
        "right": {
            "value": ["D", "Right"],
            "type": "keybind"
        },
        "accept": {
            "value": ["Space", "Enter"],
            "type": "keybind"
        },
        "back": {
            "value": ["ESC", "BackSpace"],
            "type": "keybind"
        },
        "reset": {
            "value": ["R"],
            "type": "keybind"
        }
    },
    "graphics": {
        "Fps": {
            "value": 60,
            "type": "int",
            "min": 30,
            "max": 240,
            "description": "Pretty self-explanatory, isn't it?"
        },
        "FpsCounter": {
            "value": true,
            "type": "bool",
            "description": "If unchecked, hides FPS Counter."
        },
        "VSync": {
            "value": true,
            "type": "bool",
            "description": "Eliminates screen tearing.\nMay cause a slight amount of input lag."
        }
    },
    "gameplay": {
        "DownScroll": {
            "value": false,
            "type": "bool",
            "description": "If checked, notes go Down instead of Up, simple enough."
        },
        "MiddleScroll": {
            "value": false,
            "type": "bool",
            "description": "If checked, your notes get centered."
        },
        "OpponentNotes": {
            "value": true,
            "type": "bool",
            "description": "If unchecked, opponent notes get hidden."
        },
        "GhostTapping": {
            "value": true,
            "type": "bool",
            "description": "If checked, you won't get misses from pressing keys\nwhile there are no notes able to be hit."
        },
        "RatingOffset": {
            "value": 0,
            "type": "int",
            "min": -30,
            "max": 30,
            "description": "Changes how late/early you have to hit for a 'Sick!'\nHigher values mean you have to hit later."
        }
    }
